// Configuration Cloudflare Workers du site Dune Lab
// Documentation : https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dunelab",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  // Fichiers du site, servis tels quels
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Ces adresses passent d'abord par le code du Worker : le formulaire,
    // et l'espace admin (vérification de Cloudflare Access avant tout fichier)
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },

  // Base de l'espace admin (clients, devis, factures). Créée par :
  //   npx wrangler d1 create dunelab-admin --jurisdiction eu
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dunelab-admin",
      // Base créée dans le tableau de bord (Storage & Databases › D1)
      "database_id": "9fb89185-a3df-4bd5-ab7a-f6743fb0d0f5",
      "migrations_dir": "migrations"
    }
  ],

  // Archives : PDF des devis, factures et avoirs, sauvegardes de la base. Créé par :
  //   npx wrangler r2 bucket create dunelab-archives --jurisdiction eu
  "r2_buckets": [
    {
      "binding": "ARCHIVES",
      "bucket_name": "dunelab-archives",
      "jurisdiction": "eu"
    }
  ],

  // Sauvegarde de la base dans R2, chaque nuit à 3 h UTC
  "triggers": { "crons": ["0 3 * * *"] },

  "vars": {
    // Emails du formulaire, envoyés par Resend (clé API : secret RESEND_API_KEY)
    // Adresse qui reçoit les demandes de devis. À COMPLÉTER.
    "MAIL_TO": "contact@example.com",
    // Expéditeur : une adresse du domaine vérifié dans Resend. À COMPLÉTER.
    "MAIL_FROM": "formulaire@example.com",

    // Espace admin protégé par Cloudflare Access (voir README, « Espace admin »)
    // Domaine de l'équipe Zero Trust
    "ACCESS_TEAM_DOMAIN": "https://cool-feather-12aa.cloudflareaccess.com",
    // Sur ce Worker public, l'admin reste fermé (404) : il est servi par
    // « dunelab-admin » (voir « env » plus bas), derrière Access
    "ACCESS_AUD": "À COMPLÉTER",
    // La seule adresse autorisée (ADMIN_EMAIL) est un secret du Worker, pas une
    // variable : le dépôt est public. Tableau de bord › Worker › Settings ›
    // Variables and Secrets, ou npx wrangler secret put ADMIN_EMAIL.

    // Facturation électronique (obligatoire en septembre 2027) : plateforme agréée
    // à laquelle les factures émises sont transmises. « aucun » tant que rien n'est
    // branché ; connecteurs disponibles dans src/admin/connecteurs/.
    "FACTURATION_ELECTRONIQUE": "aucun"
  },

  "observability": { "enabled": true },

  // Admin publié à part : le même code sous le nom « dunelab-admin »
  // (dunelab-admin.<sous-domaine>.workers.dev), entièrement derrière Cloudflare
  // Access, pendant que le site « dunelab » reste public sans connexion.
  // Déploiement : npx wrangler deploy --env admin. Variables et bindings ne
  // s'héritent pas d'un environnement : ils sont redéclarés ici.
  "env": {
    "admin": {
      "name": "dunelab-admin",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dunelab-admin",
          "database_id": "9fb89185-a3df-4bd5-ab7a-f6743fb0d0f5",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ARCHIVES",
          "bucket_name": "dunelab-archives",
          "jurisdiction": "eu"
        }
      ],
      // La sauvegarde nocturne tourne sur « dunelab » : pas de doublon ici
      "triggers": { "crons": [] },
      "vars": {
        "MAIL_TO": "contact@example.com",
        "MAIL_FROM": "formulaire@example.com",
        "ACCESS_TEAM_DOMAIN": "https://cool-feather-12aa.cloudflareaccess.com",
        // AUD de l'application Access du Worker « dunelab-admin »
        "ACCESS_AUD": "bb8081e085ce3ccef6b74a748f288501fe6f477e0959729d37024305aefb87b8",
        "FACTURATION_ELECTRONIQUE": "aucun"
      }
    }
  }
}
